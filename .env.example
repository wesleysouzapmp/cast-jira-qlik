# ---- Servidor ----
# Jira Cloud usado por todos os usuários (cada um cadastra o próprio token em Minha conta).
JIRA_BASE_URL=https://tjmg.atlassian.net
# Porta local; o servidor escuta só em 127.0.0.1.
PORT=3100

# Chave mestra (32 bytes em base64) que cifra os tokens do Jira e as chaves Anthropic no banco.
# O setup.sh gera. Para gerar à mão:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde-a com cuidado: sem ela os segredos gravados no banco não podem ser lidos.
APP_SECRET_KEY=

# Host público atrás do proxy reverso (Caddy com HTTPS), ex.: meu-app.duckdns.org.
# Vazio = uso só local (http://127.0.0.1:PORT). Com valor: cookie Secure, URL do conector MCP
# https://<PUBLIC_HOST>/mcp e X-Forwarded-For aceito só de conexões vindas do loopback.
PUBLIC_HOST=

# Pasta do banco (app.db). Padrão: ./data dentro do projeto.
DATA_DIR=

# Apontamentos automáticos: off (ou 0/false/não) desliga o agendador.
AUTO_WORKLOG=

# ---- DNS dinâmico (usado pelos scripts de implantação, não pelo servidor) ----
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# ---- Migração do modo antigo (um usuário) ----
# Lidas UMA vez por `node src/admin.js bootstrap` para criar o primeiro admin com este token.
# O servidor não usa mais estas variáveis; depois do bootstrap podem ser apagadas.
JIRA_EMAIL=
JIRA_API_TOKEN=
